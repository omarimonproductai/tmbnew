# Credencials de l'API de TMB (developer.tmb.cat)
# Copia aquest fitxer a .dev.vars per a wrangler pages dev local.
# A producció es defineixen al dashboard de Cloudflare Pages (Settings → Environment variables).
# Aquestes variables NOMÉS s'usen dins les Functions (servidor), mai al client.
TMB_APP_ID=
TMB_APP_KEY=

# Credencial Cooltra MaaS Level 1 (https://maas.zeus.cooltra.com)
# Defineix STAGE per a dev local i preview; PROD només a producció.
ZEUS_API_STAGE=
ZEUS_API_PROD=
